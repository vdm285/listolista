{
  // ListoLista relay (Cloudflare Workers free plan). Deploy: wrangler deploy (from this folder).
  "name": "listolista-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": { "ALLOWED_ORIGINS": "https://vdm285.github.io,https://listolista-preview.pages.dev" },
  "workers_dev": true
}
